<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Sift" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:navigationBarColor">@color/white</item>
    </style>

    <style name="Theme.Sift.SplashScreen" parent="Theme.SplashScreen">
